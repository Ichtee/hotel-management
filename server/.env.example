MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/grandstay?retryWrites=true&w=majority
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
# Tạo khóa ngẫu nhiên dài ít nhất 32 ký tự; bắt buộc khi chạy production.
JWT_SECRET=
# Chạy npm run setup --prefix server một lần rồi xóa ADMIN_PASSWORD.
ADMIN_USERNAME=
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Ưu tiên EmailJS khi đủ bốn khóa; nếu thiếu thì dùng SMTP rồi Resend.
# Mẫu EmailJS dùng To={{to_email}}, Subject={{subject}}, body={{{html}}}; cho phép ứng dụng ngoài trình duyệt.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
# Tự dùng SePay khi đủ hai khóa; PAYMENT_PROVIDER chọn sepay hoặc sandbox.
# Lệnh npm run local luôn dùng cổng giả lập.
PAYMENT_PROVIDER=
SEPAY_ENV=sandbox
SEPAY_MERCHANT_ID=
SEPAY_SECRET_KEY=
# URL công khai để SePay chuyển khách về PUBLIC_URL/api/payments/return.
PUBLIC_URL=
# Chọn bank_transfer, e_wallet hoặc credit_card; mặc định bank_transfer.
SEPAY_METHODS=
# Chỉ đổi SEPAY_CHECKOUT_URL và SEPAY_API_URL khi địa chỉ cổng thay đổi.
# GATEWAY_SECRET ký thông báo từ cổng giả lập; bắt buộc ở production.
GATEWAY_SECRET=
SMTP_URL=
MAIL_FROM=
# Khóa mã hóa tài khoản nhận hoàn tiền; giữ ổn định, mặc định dùng JWT_SECRET.
DATA_KEY=
# Khóa tùy chọn cho cron gọi POST /api/jobs/:name qua header X-Job-Secret.
JOB_SECRET=
# Số proxy ở production: 1 nếu chỉ Render, 2 nếu Vercel chuyển tiếp đến Render.
TRUST_PROXY=1
# Bật true cho demo production không có SePay; cổng giả lập không chuyển tiền thật.
ENABLE_SANDBOX_GATEWAY=

# Khóa gửi email Resend, lấy tại https://resend.com/api-keys.
RESEND_API_KEY=
# Dùng onboarding@resend.dev để thử nghiệm hoặc tên miền đã xác minh ở production.
RESEND_FROM_EMAIL=onboarding@resend.dev
# URL frontend trong liên kết xác minh; mặc định http://localhost:5173.
CLIENT_URL=http://localhost:5173

# Khóa Google reCAPTCHA v2, lấy tại https://www.google.com/recaptcha/admin.
RECAPTCHA_SITE_KEY=your_recaptcha_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key
