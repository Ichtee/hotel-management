MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/grandstay?retryWrites=true&w=majority
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
# Generate a random secret of at least 32 characters; required in production.
SESSION_SECRET=
# One-time `npm run setup --prefix server`; remove ADMIN_PASSWORD afterward.
ADMIN_USERNAME=
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# E-mail: RESEND_API_KEY (below) sends every e-mail. SMTP_URL (e.g. smtps://user:pass@smtp.example.com) is used instead when set.
# Payment gateway: SePay is used as soon as SEPAY_MERCHANT_ID and SEPAY_SECRET_KEY are filled in.
# PAYMENT_PROVIDER=sepay forces it, PAYMENT_PROVIDER=sandbox forces the built-in test gateway. `npm run local` always uses the sandbox.
PAYMENT_PROVIDER=
SEPAY_ENV=sandbox
SEPAY_MERCHANT_ID=
SEPAY_SECRET_KEY=
# Public base URL of the site (SePay sends the browser back to PUBLIC_URL/api/payments/return).
PUBLIC_URL=
# Methods offered, any of bank_transfer, e_wallet (NAPAS QR), credit_card. Default: bank_transfer.
SEPAY_METHODS=
# Only if the SePay docs hosts change: SEPAY_CHECKOUT_URL, SEPAY_API_URL.
# Shared secret that signs the built-in sandbox gateway callbacks; required in production.
GATEWAY_SECRET=
SMTP_URL=
MAIL_FROM=
# Encrypts refund bank account numbers at rest (UC21). Keep it stable; falls back to SESSION_SECRET.
DATA_KEY=
# Optional: lets an external cron call POST /api/jobs/:name with header X-Job-Secret.
JOB_SECRET=
# Production only. Number of proxies in front of the API: 1 = Render alone, 2 = Vercel proxying /api to Render.
TRUST_PROXY=1
# Production demo without SePay: "true" lets customers pay through the built-in test gateway (moves no money).
ENABLE_SANDBOX_GATEWAY=

# Resend Email Service (Email Verification)
# API key from https://resend.com/api-keys
RESEND_API_KEY=
# Test sender for development: onboarding@resend.dev (or verified domain in production)
RESEND_FROM_EMAIL=onboarding@resend.dev
# Frontend URL for verification links (defaults to http://localhost:5173)
CLIENT_URL=http://localhost:5173

# Google reCAPTCHA v2 (Login Security)
# Obtain keys at https://www.google.com/recaptcha/admin
RECAPTCHA_SITE_KEY=your_recaptcha_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key
