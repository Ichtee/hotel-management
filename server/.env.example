MONGO_URI=mongodb://127.0.0.1:27017/hotel_booking
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
# Generate a random secret of at least 32 characters; required in production.
SESSION_SECRET=
# One-time `npm run setup --prefix server`; remove ADMIN_PASSWORD afterward.
ADMIN_USERNAME=
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional: e.g. smtps://user:pass@smtp.example.com. Without it notifications are in-app only.
SMTP_URL=
MAIL_FROM=
